---
import { Picture, getImage } from 'astro:assets';
import { imageFor, pad, type NumberedProject } from '../lib/work';

export type CardVariant = 'lead' | 'grid';

interface Props {
  project: NumberedProject;
  /** "lead": large, with the caption beside it on desktop. "grid": one cell of a two-column grid. */
  variant: CardVariant;
  /** Above-the-fold images load immediately; the rest are lazy. */
  eager?: boolean;
}

const { project, variant, eager = false } = Astro.props;
const image = imageFor(project.file);

// Full-size WebP: the no-JavaScript link target, and the source of the original dimensions.
// (Reading width/height from getImage instead of the import keeps the untouched originals out of dist/.)
const full = await getImage({ src: image, format: 'webp' });
const width = Number(full.attributes.width);
const height = Number(full.attributes.height);

if (Math.abs(width / height - 16 / 9) > 0.01) {
  console.warn(`[projects] "${project.file}" is ${width}×${height}, not 16:9 — it will be cropped in the grid.`);
}

// Never upscale: the largest candidate is the original width.
const widths = [480, 720, 960, 1280].filter((w) => w < width).concat(width);

// Rendered widths per layout (see --gutter/--gap in global.css and the grids in WorkSection.astro).
const sizes = {
  lead: '(min-width: 1680px) 1020px, (min-width: 1024px) and (max-height: 880px) 52vw, (min-width: 1024px) 62vw, (min-width: 640px) 92vw, 100vw',
  grid: '(min-width: 1680px) 762px, (min-width: 900px) 46vw, (min-width: 640px) 92vw, calc(100vw - 32px)',
}[variant];

const number = pad(project.number);
const imgId = `work-${project.id}-img`;
const linkLabelId = `work-${project.id}-label`;
const label = project.headline ? `“${project.title}”` : project.title;
const meta = [...project.tags, project.context].filter(Boolean).join(' · ');
---

<figure
  class={`work-card work-card--${variant}`}
  id={`work-${project.id}`}
  data-work
  data-reveal={variant === 'lead' ? undefined : ''}
  data-title={label}
  data-lang={project.lang}
  data-translation={project.translation}
  data-tags={meta}
  data-note={project.note}
  data-process={project.process}
  data-width={width}
  data-height={height}
>
  <a class="work-card__frame" href={full.src} aria-labelledby={linkLabelId} aria-describedby={imgId}>
    <span class="sr-only" id={linkLabelId}>
      <span lang={project.lang}>{project.title}</span> — view larger
    </span>
    <Picture
      src={image}
      alt={project.alt}
      id={imgId}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      class="work-card__img"
    />
  </a>

  <figcaption class="work-card__caption">
    <span class="work-card__num caps" aria-hidden="true">{number}</span>
    <div class="work-card__text">
      <h3 class="work-card__title" lang={project.lang}>{label}</h3>
      {
        project.translation && (
          <p class="work-card__translation">
            <span class="caps">EN</span> {project.translation}
          </p>
        )
      }
      <p class="work-card__tags caps">
        <span>{meta}</span>
        {project.lang && <span class="badge">{project.lang.toUpperCase()}</span>}
      </p>
      {project.note && <p class="work-card__note">{project.note}</p>}
    </div>
  </figcaption>
</figure>

<style>
  .work-card {
    min-width: 0;
  }

  .work-card__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    cursor: zoom-in;
    isolation: isolate;
  }

  /* Hairline edge so dark thumbnails keep their shape against the dark page. */
  .work-card__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
    pointer-events: none;
    transition: box-shadow 0.4s var(--ease);
  }

  .work-card__frame :global(picture),
  .work-card__frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .work-card__frame :global(img) {
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  @media (hover: hover) {
    .work-card__frame:hover :global(img) {
      transform: scale(1.022);
    }

    .work-card__frame:hover::after {
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2);
    }

    .work-card:has(.work-card__frame:hover) .work-card__title {
      background-size: 100% 1px;
    }
  }

  .work-card__frame:focus-visible {
    outline-offset: 4px;
  }

  /* ── Caption ─────────────────────────────────────────────── */
  .work-card__caption {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    padding-top: 14px;
  }

  .work-card__num {
    padding-top: 0.25em;
  }

  .work-card__text {
    display: grid;
    gap: 3px;
    justify-items: start;
  }

  .work-card__title {
    font-size: 0.9688rem;
    line-height: 1.35;
    font-weight: 580;
    text-wrap: pretty;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0% 1px;
    transition: background-size 0.45s var(--ease-out);
  }

  .work-card__translation {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .work-card__translation .caps {
    margin-right: 4px;
  }

  .work-card__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 3px;
  }

  .work-card__note {
    max-width: 54ch;
    margin-top: 8px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* ── Lead piece ──────────────────────────────────────────── */
  .work-card--lead .work-card__title {
    font-size: 1.0625rem;
  }

  .work-card--lead .work-card__note {
    font-size: 0.9375rem;
  }

  /* Phones: the lead runs edge to edge like a cover; other notes stay in the viewer. */
  @media (max-width: 639px) {
    .work-card--lead .work-card__frame {
      margin-inline: calc(-1 * var(--gutter));
      border-radius: 0;
    }

    .work-card--lead .work-card__frame::after {
      box-shadow: none;
    }

    .work-card--grid .work-card__note {
      display: none;
    }
  }

  /* Phone held sideways: keep every thumbnail fully visible within the screen height. */
  @media (max-height: 480px) {
    .work-card__frame {
      max-width: calc((100vh - 32px) * 16 / 9);
    }
  }

  /* Desktop: an editorial spread — the image on eight of the twelve columns, its caption beside it.
     On shorter screens the image steps down to seven or six columns, so the whole piece stays above
     the fold and the caption still starts on a column line. */
  @media (min-width: 1024px) {
    .work-card--lead {
      --fit: calc((100vh - 22rem) * 16 / 9); /* widest image that fits the screen height */
      --lead-w: max(50% - var(--gap) / 2, min(66.667% - var(--gap) / 3, var(--fit)));

      display: grid;
      grid-template-columns: var(--lead-w) minmax(0, 1fr);
      column-gap: var(--gap);
    }

    @supports (width: round(down, 10px, 3px)) {
      .work-card--lead {
        --col: calc((100% + var(--gap)) / 12); /* one column plus its gap */
        --fit: calc((100svh - 22rem) * 16 / 9);
        --lead-w: clamp(
          6 * var(--col) - var(--gap),
          round(down, var(--fit) + var(--gap), var(--col)) - var(--gap),
          8 * var(--col) - var(--gap)
        );
      }
    }

    .work-card--lead .work-card__caption {
      align-self: end;
      padding-top: 0;
      padding-bottom: 2px;
    }
  }
</style>
