---
import { hero } from '../data/site';
---

<section class="hero container" id="top" aria-labelledby="hero-title">
  <div class="hero__keywords sep-list-wrap">
    <ul class="sep-list" aria-label="Focus">
      {hero.keywords.map((word) => <li>{word}</li>)}
    </ul>
  </div>

  <h1 class="hero__statement" id="hero-title">{hero.statement}</h1>

  <div class="hero__aside">
    <div class="hero__fields caps sep-list-wrap">
      <ul class="sep-list" aria-label="Fields">
        {hero.fields.map((field) => <li>{field}</li>)}
      </ul>
    </div>
    {hero.hint && <p class="hero__hint">{hero.hint}</p>}
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 18px;
    padding-top: clamp(28px, 5vh, 72px);
    padding-bottom: clamp(32px, 5vh, 64px);
  }

  /* Credit-style line: the three ideas the first screen has to communicate. */
  .hero__keywords {
    --sep: '/';

    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.875rem);
    line-height: 1.4;
    font-weight: 600;
    font-stretch: 120%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    animation: hero-rise 1s var(--ease-out) 0.05s both;
  }

  .hero__statement {
    max-width: 24ch;
    font-size: clamp(1.75rem, 1rem + 2vw, 2.875rem);
    line-height: 1.1;
    font-weight: 520;
    letter-spacing: -0.015em;
    text-wrap: balance;
    animation: hero-rise 1.1s var(--ease-out) 0.14s both;
  }

  .hero__aside {
    display: grid;
    gap: 10px;
    align-content: end;
    margin-top: 6px;
    animation: hero-rise 1.1s var(--ease-out) 0.28s both;
  }

  .hero__hint {
    max-width: 38ch;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* Phone held sideways: get to the work sooner. */
  @media (max-height: 480px) {
    .hero__hint {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .hero__keywords {
      grid-column: 1 / -1;
    }

    .hero__statement {
      grid-column: 1 / span 8;
      grid-row: 2;
    }

    .hero__aside {
      grid-column: 9 / span 4;
      grid-row: 2;
      margin-top: 0;
      padding-bottom: 0.4em;
    }
  }

  /* Short laptop screens: tighter vertical rhythm so the lead piece stays above the fold. */
  @media (min-width: 1024px) and (max-height: 880px) {
    .hero {
      gap: 14px;
      padding-top: 22px;
      padding-bottom: 28px;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
